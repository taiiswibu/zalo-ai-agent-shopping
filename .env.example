# Local: SQLite; cloud: postgresql+psycopg://user:password@host:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./data/app.db
BOT_TOKEN=
WEBHOOK_SECRET=replace-with-a-random-32-character-secret
ADMIN_TOKEN=replace-with-another-random-32-character-secret
BOT_MODE=mock
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# CSV / crawling: only domains you are authorized to access
CRAWL_ALLOWED_HOSTS=
PUBLIC_BASE_URL=
# v2: OPTIONAL. Use Gemini free-tier Google AI Studio project for natural answers.
RAG_BACKEND=keyword
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=10
